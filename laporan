<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Laporan Berpages BE2026 – Unit Harga-Harga</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
:root{
  --navy:#070f1f;--navy2:#0c1a32;--navy3:#132240;
  --blue:#1e40af;--blue2:#2563eb;--blue3:#3b82f6;
  --accent:#38bdf8;--teal:#0ea5e9;--teal2:#06b6d4;
  --gold:#f59e0b;--gold2:#fbbf24;--gold3:#fde68a;
  --green:#10b981;--green2:#34d399;--red:#ef4444;--red2:#f87171;
  --purple:#8b5cf6;--purple2:#a78bfa;--cyan:#06b6d4;
  --bg:#f0f4f8;--bg2:#e2e8f0;--card:#ffffff;--card2:#f8fafc;
  --border:#e2e8f0;--border2:#cbd5e1;--text:#0f172a;--text2:#1e293b;
  --muted:#64748b;--muted2:#94a3b8;--light:#f1f5f9;
  --font:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,sans-serif;
  --mono:'DM Mono',ui-monospace,monospace;
  --shadow-sm:0 1px 2px 0 rgba(0,0,0,0.05);
  --shadow:0 4px 6px -1px rgba(0,0,0,0.1),0 2px 4px -2px rgba(0,0,0,0.1);
  --shadow-md:0 10px 15px -3px rgba(0,0,0,0.1),0 4px 6px -4px rgba(0,0,0,0.1);
  --shadow-lg:0 20px 25px -5px rgba(0,0,0,0.1),0 8px 10px -6px rgba(0,0,0,0.1);
  --shadow-xl:0 25px 50px -12px rgba(0,0,0,0.25);
  --shadow-glow:0 0 20px rgba(37,99,235,0.15);
  --radius-sm:6px;--radius:10px;--radius-lg:14px;--radius-xl:20px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
body{font-family:var(--font);background:linear-gradient(135deg,#f0f4f8 0%,#e0e7ef 50%,#f1f5f9 100%);color:var(--text);padding:0;-webkit-print-color-adjust:exact;print-color-adjust:exact;min-height:100vh}

/* ═══ CONTROL BAR ═══ */
.bar{position:sticky;top:0;z-index:60;background:linear-gradient(135deg,var(--navy) 0%,var(--navy2) 60%,var(--navy3) 100%);color:#fff;padding:12px 20px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;box-shadow:var(--shadow-xl);border-bottom:1px solid rgba(255,255,255,0.06);backdrop-filter:blur(12px)}
.bar::before{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--accent),var(--teal2),var(--blue2),transparent);opacity:.6}
.bar .t{font-weight:800;letter-spacing:.04em;font-size:.88rem;margin-right:8px;display:flex;align-items:center;gap:8px}
.bar .t::before{content:'';display:inline-block;width:8px;height:8px;border-radius:50%;background:linear-gradient(135deg,var(--green),var(--green2));box-shadow:0 0 8px var(--green2);animation:pulse 2s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.7;transform:scale(.85)}}
.bar label{font-size:.62rem;font-weight:700;color:#8ba3c7;text-transform:uppercase;letter-spacing:.08em;margin-left:8px;white-space:nowrap}
.bar select{border:1px solid rgba(255,255,255,0.1);border-radius:var(--radius-sm);padding:6px 10px;font-size:.74rem;font-family:var(--font);background:rgba(255,255,255,0.06);color:#fff;cursor:pointer;transition:all .2s;outline:none;min-width:100px}
.bar select:hover,.bar select:focus{background:rgba(255,255,255,0.12);border-color:rgba(255,255,255,0.2)}
.bar option{background:var(--navy2);color:#fff}
.bar input{border:1px solid rgba(255,255,255,0.1);border-radius:var(--radius-sm);padding:6px 12px;font-size:.72rem;font-family:var(--mono);background:rgba(255,255,255,0.06);color:#fff;width:200px;max-width:40vw;transition:all .2s;outline:none}
.bar input:focus{background:rgba(255,255,255,0.12);border-color:var(--accent);box-shadow:0 0 0 3px rgba(56,189,248,0.15)}
.bar .sp{flex:1}
.btn{background:linear-gradient(135deg,var(--blue2),var(--blue3));color:#fff;border:none;border-radius:var(--radius-sm);padding:7px 14px;font-size:.74rem;font-weight:700;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:all .2s;box-shadow:0 2px 8px rgba(37,99,235,0.25);position:relative;overflow:hidden}
.btn::after{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.2),transparent);transition:left .5s}
.btn:hover{transform:translateY(-1px);box-shadow:0 4px 16px rgba(37,99,235,0.35)}
.btn:hover::after{left:100%}
.btn.alt{background:linear-gradient(135deg,var(--accent),var(--teal2));box-shadow:0 2px 8px rgba(56,189,248,0.25)}
.btn.alt:hover{box-shadow:0 4px 16px rgba(56,189,248,0.35)}
.btn.gh{background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);color:#c8d6e8;box-shadow:none}
.btn.gh:hover{background:rgba(255,255,255,0.12);color:#fff}

/* ═══ PAGE (landscape A4) ═══ */
.page{width:min(297mm,100%);min-height:200mm;background:var(--card);margin:0 auto 24px;padding:16mm 16mm 14mm;box-shadow:var(--shadow-lg);position:relative;display:flex;flex-direction:column;border-radius:var(--radius);overflow:hidden;transition:box-shadow .3s}
.page:hover{box-shadow:var(--shadow-xl)}
.page::before{content:'';position:absolute;top:0;left:0;right:0;height:5px;background:linear-gradient(90deg,var(--blue2),var(--accent),var(--teal2),var(--green))}
.page::after{content:'';position:absolute;top:5px;right:40px;width:120px;height:120px;background:radial-gradient(circle,rgba(37,99,235,0.04) 0%,transparent 70%);pointer-events:none}
.rpt-head{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #e8edf5;padding-bottom:14px;margin-bottom:18px;margin-top:6px;position:relative}
.rpt-head::after{content:'';position:absolute;bottom:-2px;left:0;width:80px;height:2px;background:linear-gradient(90deg,var(--blue2),var(--accent));border-radius:2px}
.rpt-head .badge{width:48px;height:48px;background:linear-gradient(135deg,var(--blue2),var(--accent));border-radius:var(--radius);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;box-shadow:0 4px 12px rgba(37,99,235,0.25);position:relative;overflow:hidden}
.rpt-head .badge::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent 40%,rgba(255,255,255,0.2) 100%)}
.rpt-head .l{display:flex;align-items:center;gap:14px}
.rpt-head .l h1{font-size:1.18rem;font-weight:800;color:var(--navy2);line-height:1.2;letter-spacing:-0.02em}
.rpt-head .l p{font-size:.74rem;color:var(--muted);margin-top:4px;letter-spacing:.01em;font-weight:500}
.rpt-head .r{text-align:right;font-size:.7rem;color:var(--muted)}
.rpt-head .r .tag{display:inline-block;background:linear-gradient(135deg,var(--navy2),var(--navy3));color:#fff;border-radius:20px;padding:4px 14px;font-size:.66rem;font-weight:700;letter-spacing:.04em;margin-bottom:6px;box-shadow:var(--shadow-sm)}
.rpt-head .r .scope{font-family:var(--mono);color:var(--blue2);font-weight:600;font-size:.76rem;background:var(--light);padding:2px 8px;border-radius:4px;display:inline-block;margin-top:2px}
.rpt-head .r .date{margin-top:4px;color:var(--muted2);font-size:.66rem}
.sec-h{font-size:.9rem;font-weight:800;color:var(--navy2);text-transform:uppercase;letter-spacing:.06em;margin:10px 0 14px;padding:8px 0 8px 14px;border-left:4px solid var(--blue2);background:linear-gradient(90deg,#f1f5f9,transparent);border-radius:0 var(--radius-sm) var(--radius-sm) 0;display:flex;align-items:center;gap:8px}
.sec-h small{font-weight:500;color:var(--muted);text-transform:none;letter-spacing:0;font-size:.72rem;margin-left:auto;padding-right:8px}
.note{font-size:.72rem;color:var(--muted);margin:14px 0 0;line-height:1.7;background:linear-gradient(135deg,#f8fafc,#f1f5f9);border-left:3px solid var(--accent);padding:10px 14px;border-radius:0 var(--radius-sm) var(--radius-sm) 0;position:relative}
.note::before{content:'ⓘ';position:absolute;left:-12px;top:50%;transform:translateY(-50%);background:var(--accent);color:#fff;width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700}
.grow{flex:1}
.foot{margin-top:16px;border-top:1px solid #e8edf5;padding-top:10px;display:flex;justify-content:space-between;font-size:.66rem;color:var(--muted2);font-weight:500}

/* ═══ STAT TILES ═══ */
.sgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.sc{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:18px 16px;position:relative;overflow:hidden;box-shadow:var(--shadow-sm);transition:all .3s cubic-bezier(.4,0,.2,1);cursor:default}
.sc:hover{transform:translateY(-3px);box-shadow:var(--shadow-md);border-color:var(--border2)}
.sc::after{content:'';position:absolute;top:0;left:0;bottom:0;width:4px;background:linear-gradient(180deg,var(--blue2),var(--accent));border-radius:var(--radius-lg) 0 0 var(--radius-lg)}
.sc.g::after{background:linear-gradient(180deg,var(--green),var(--green2))}
.sc.gd::after{background:linear-gradient(180deg,var(--gold),var(--gold2))}
.sc.r::after{background:linear-gradient(180deg,var(--red),var(--red2))}
.sc.p::after{background:linear-gradient(180deg,var(--purple),var(--purple2))}
.sc.c::after{background:linear-gradient(180deg,var(--cyan),var(--accent))}
.sc.a::after{background:linear-gradient(180deg,var(--accent),var(--teal2))}
.sc.n::after{background:linear-gradient(180deg,var(--navy2),var(--blue))}
.sc .ic{position:absolute;right:14px;top:14px;font-size:1.6rem;opacity:.08;transition:all .3s}
.sc:hover .ic{opacity:.15;transform:scale(1.1) rotate(-5deg)}
.sc .lab{font-size:.62rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px;padding-left:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sc .val{font-family:var(--mono);font-size:1.6rem;font-weight:500;color:var(--navy);padding-left:8px;line-height:1.2;letter-spacing:-0.02em}
.sc .s{font-size:.66rem;color:var(--muted);margin-top:6px;padding-left:8px;font-weight:500;display:flex;align-items:center;gap:4px}
.sc .s b{color:var(--text2);font-weight:700}
.sc .s .dot{width:6px;height:6px;border-radius:50%;display:inline-block;background:var(--muted2)}
.sc .s .dot.up{background:var(--green)}
.sc .s .dot.down{background:var(--red)}

/* ═══ TABLE ═══ */
.tw{overflow-x:auto;border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-sm);background:var(--card);transition:box-shadow .3s}
.tw:hover{box-shadow:var(--shadow-md)}
table.rt{width:100%;border-collapse:separate;border-spacing:0;font-size:.72rem}
table.rt th{background:linear-gradient(135deg,var(--navy2) 0%,var(--navy3) 100%);color:#fff;font-weight:700;padding:10px 10px;text-align:center;font-size:.62rem;letter-spacing:.04em;text-transform:uppercase;line-height:1.3;position:sticky;top:0;z-index:10;white-space:nowrap}
table.rt th:first-child{border-radius:var(--radius) 0 0 0}
table.rt th:last-child{border-radius:0 var(--radius) 0 0}
table.rt th.l,table.rt td.l{text-align:left}
table.rt td{padding:8px 10px;border-bottom:1px solid #f1f5f9;text-align:right;font-family:var(--mono);white-space:nowrap;transition:background .15s}
table.rt td.l{font-family:var(--font);white-space:normal;font-weight:500;color:var(--text2)}
table.rt tbody tr:nth-child(even) td{background:#fafbfc}
table.rt tbody tr:hover td{background:#eef4ff}
table.rt tr.tot td{background:linear-gradient(135deg,#e8effd,#dde8fb);font-weight:800;color:var(--navy);border-top:2px solid var(--blue2);border-bottom:none}
table.rt tr.tot td:first-child{border-radius:0 0 0 var(--radius)}
table.rt tr.tot td:last-child{border-radius:0 0 var(--radius) 0}
table.rt .hl{background:linear-gradient(135deg,var(--blue2),var(--blue3))!important;color:#fff!important;font-weight:700;border-radius:4px;padding:4px 8px;display:inline-block;box-shadow:0 2px 6px rgba(37,99,235,0.25)}
table.rt td .hl{margin:0}
.rkno{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,#e2e8f0,#f1f5f9);color:#475569;font-weight:800;font-size:.66rem;font-family:var(--font);box-shadow:var(--shadow-sm);transition:all .2s}
tr:hover .rkno{transform:scale(1.1);box-shadow:var(--shadow)}

/* ═══ PODIUM ═══ */
.podium{display:flex;align-items:flex-end;justify-content:center;gap:16px;margin:8px 0 22px;min-height:200px}
.pod{flex:1;max-width:240px;border-radius:var(--radius-lg);padding:20px 16px;text-align:center;color:#fff;position:relative;box-shadow:var(--shadow-lg);transition:all .3s cubic-bezier(.4,0,.2,1);overflow:hidden}
.pod:hover{transform:translateY(-6px);box-shadow:var(--shadow-xl)}
.pod::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 60%,rgba(0,0,0,0.15) 100%);pointer-events:none}
.pod::after{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(circle,rgba(255,255,255,0.15) 0%,transparent 60%);pointer-events:none}
.pod .crown{font-size:2rem;filter:drop-shadow(0 2px 4px rgba(0,0,0,0.2));position:relative;z-index:1}
.pod .nm{font-weight:800;font-size:.95rem;margin:8px 0 3px;letter-spacing:.01em;position:relative;z-index:1;text-shadow:0 1px 2px rgba(0,0,0,0.1)}
.pod .pen{font-size:.68rem;opacity:.9;margin-bottom:12px;position:relative;z-index:1;font-weight:500}
.pod .num{font-family:var(--mono);font-size:1.9rem;font-weight:600;line-height:1;position:relative;z-index:1;text-shadow:0 2px 4px rgba(0,0,0,0.15)}
.pod .cap{font-size:.68rem;opacity:.92;margin-top:4px;position:relative;z-index:1;font-weight:500}
.pod.p1{background:linear-gradient(135deg,#f59e0b 0%,#fbbf24 50%,#fde68a 100%);padding-top:30px;padding-bottom:32px;transform:scale(1.05);z-index:2}
.pod.p1:hover{transform:scale(1.08) translateY(-8px)}
.pod.p2{background:linear-gradient(135deg,#64748b 0%,#94a3b8 100%);padding-bottom:24px}
.pod.p3{background:linear-gradient(135deg,#b45309 0%,#d97706 100%);padding-bottom:20px}

/* ═══ CHARTS ═══ */
.charts2{display:grid;grid-template-columns:1.4fr 1fr;gap:20px;align-items:start}
.chart-box{height:240px;position:relative}
.chart-box::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 50% 0%,rgba(37,99,235,0.03) 0%,transparent 70%);pointer-events:none;border-radius:var(--radius)}
.cw{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:18px 18px;box-shadow:var(--shadow-sm);transition:all .3s}
.cw:hover{box-shadow:var(--shadow-md);border-color:var(--border2)}
.cw h4{font-size:.72rem;font-weight:800;color:var(--navy2);text-transform:uppercase;letter-spacing:.05em;margin-bottom:12px;display:flex;align-items:center;gap:6px}
.cw h4::before{content:'';display:inline-block;width:3px;height:14px;background:linear-gradient(180deg,var(--blue2),var(--accent));border-radius:2px}

/* ═══ LOADING ═══ */
#load{position:fixed;inset:0;background:linear-gradient(135deg,rgba(7,15,31,0.92),rgba(12,26,50,0.95));display:flex;align-items:center;justify-content:center;z-index:9999;color:#fff;font-size:1rem;flex-direction:column;gap:18px;backdrop-filter:blur(8px)}
.spn{width:48px;height:48px;border:4px solid rgba(255,255,255,0.1);border-top-color:var(--accent);border-right-color:var(--teal2);border-radius:50%;animation:spin .9s linear infinite;box-shadow:0 0 20px rgba(56,189,248,0.2)}
@keyframes spin{to{transform:rotate(360deg)}}
#load .load-text{font-weight:600;letter-spacing:.02em;font-size:.9rem;opacity:.9}
#load .load-sub{font-size:.74rem;opacity:.5;font-weight:400;margin-top:-10px}
#err{display:none;max-width:720px;margin:40px auto;background:linear-gradient(135deg,#fef2f2,#fff5f5);border:1px solid #fecaca;color:#991b1b;border-radius:var(--radius-lg);padding:20px 24px;font-size:.88rem;box-shadow:var(--shadow-lg);text-align:center}
#err b{color:#7f1d1d}

/* ═══ SCROLLBAR ═══ */
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-track{background:var(--bg);border-radius:4px}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px}
::-webkit-scrollbar-thumb:hover{background:var(--muted)}

/* ═══ PRINT ═══ */
@media print{
  body{background:#fff;padding:0}
  .bar{display:none}
  .page{box-shadow:none;margin:0;width:auto;min-height:auto;padding:10mm;break-after:page;border-radius:0;background:#fff}
  .page:last-child{break-after:auto}
  .page::before{height:3px}
  .page::after{display:none}
  .sc,.cw,.tw,.pod{box-shadow:none;border-color:#e2e8f0}
  .sc:hover,.pod:hover,.tw:hover,.cw:hover{transform:none;box-shadow:none}
  .sc .ic,.pod::after,.pod::before{display:none}
  table.rt th{background:var(--navy2)!important;color:#fff!important}
  table.rt .hl{background:var(--blue2)!important;color:#fff!important}
  .note{background:#f8fafc!important}
}
@page{size:A4 landscape;margin:6mm}

/* ═══ RESPONSIVE ═══ */
@media(max-width:900px){
  .sgrid{grid-template-columns:repeat(2,1fr)}
  .charts2{grid-template-columns:1fr}
  .podium{flex-direction:column;align-items:stretch;gap:12px}
  .pod{max-width:none;transform:none!important}
  .pod.p1{transform:none!important;padding-top:20px;padding-bottom:20px}
  .page{padding:12px}
  .bar{padding:10px 12px}
  .bar input{width:140px}
}
@media(max-width:640px){
  .sgrid{grid-template-columns:1fr}
  .bar .t{font-size:.78rem}
  .bar label{display:none}
  .bar select{min-width:80px;font-size:.7rem;padding:5px 6px}
  .rpt-head .l h1{font-size:.95rem}
  .rpt-head .badge{width:40px;height:40px;font-size:18px}
  .sec-h{font-size:.8rem}
  .sc .val{font-size:1.3rem}
  .pod .num{font-size:1.5rem}
  .pod .nm{font-size:.82rem}
}
</style>
